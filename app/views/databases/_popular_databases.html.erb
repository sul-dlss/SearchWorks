  
<div class="drawer-header">
  <h2 class="drawer-title" id="popular-databases-label">Popular Databases</h2>
  <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
</div>
<header class="h2 pt-5 mb-5 d-none md:d-block test">
  Popular Databases
</header>
<div class="drawer-body flex-column">
  <ul class="list-unstyled">
    <% @selected_databases.each do |document| %>
      <li class="mb-5">
        <div class="fw-semibold"><%= link_to(Settings.selected_databases[document.id]&.title || document.first('title_245a_display'), document, class: 'fw-semibold fg-body link-decoration-none') %></div>
        <div><%= Settings.selected_databases[document.id]&.description %></div>
        <% link = document.preferred_online_links&.first %>
        <% if link.present? %>
          <div><%= render Searchworks4::LinkComponent.new(link: link, document: document) %></div>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
