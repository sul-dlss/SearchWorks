<turbo-frame id="search-suggestions">
  <div class="menu show">
    <% if @facet_response.aggregations['db_az_subject']&.items&.any? %>
      <div class="menu-header fg-secondary">Subject areas</div>
      <% @facet_response.aggregations['db_az_subject'].items.each do |item| %>
        <%= link_to highlight(item.value, @query.split), databases_url(f: { db_az_subject: [item.value] }), class: 'menu-item' %>
      <% end %>
    <% end %>

    <% if @title_response.documents.any? %>
      <div class="menu-header fg-secondary">Titles</div>
      <% @title_response.documents.each do |document| %>
        <%= link_to highlight(document['title_display'], @query.split), solr_document_url(document.id), class: 'menu-item' %>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
