<% @page_title = t 'blacklight.search.masthead_title', title: 'Databases', application_name: "#{I18n.t('blacklight.application_name')} catalog" %>
<% content_for(:search_navbar) do %>
  <%= render 'header' %>
<% end %>
<div class="d-flex justify-content-between align-items-center">
  <h2>Database topics</h2>
  <button class="btn btn-solid theme-primary md:d-none" type="button" data-bs-toggle="drawer" data-bs-target="#popular-databases-drawer" aria-controls="popular-databases-drawer">Popular databases</button>
</div>
<div class="row gx-12">
  <section class="col-12 md:col-8 lg:col-9">
    <%= render 'db_az_subjects' %>
  </section>
  <aside class="md:col-4 lg:col-3 popular-databases-aside">
    <dialog class="md:drawer drawer-bottom flex-column popular-databases" id="popular-databases-drawer" aria-labelledby="popular-databases-label">
      <%= render 'popular_databases' %>
    </dialog>
  </aside>
</div>
<% content_for(:breadcrumb) do %>
  <a href="/" class="icon-link"><%= back_icon %> Back to catalog search</a>
<% end %>
