<% if @catalog_count || @article_count %>
  <%= link_to("Catalog selections (#{@catalog_count})", bookmarks_path, data: { attribute: "added-list" }, class: 'menu-item', role: 'menuitem', tabindex: '-1') %>
  <%= link_to("Articles+ selections (#{@article_count})", article_selections_path,  data: { attribute: "added-list" }, class: 'menu-item', role: 'menuitem', tabindex: '-1') %>
  <hr class="menu-divider" role="presentation" data-attribute="added-list">
<% end %>
