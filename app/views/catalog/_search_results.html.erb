<%# locals: (content_classes: document_index_view_type == :gallery ? 'md:col-8 2xl:col-9 2xl:px-7 lg:ps-7 ps-3' : 'md:col-8 2xl:col-6 2xl:px-7 lg:ps-7 ps-3', hide_constraints: false, hide_facets: false, database_aside: false) %>
<% if page_location.collection? && get_collection.present? %>
  <% @page_title = t 'blacklight.search.masthead_title', title: "#{document_presenter(@parent).heading} Collection", application_name: "#{I18n.t('blacklight.application_name')} catalog" %>
<% elsif page_location.access_point? %>
  <% if page_location.sdr? %>
    <% @page_title = t 'blacklight.search.masthead_title', title: "SDR items", application_name: "#{I18n.t('blacklight.application_name')} catalog" %>
  <% else %>
    <% @page_title = t 'blacklight.search.masthead_title', title: page_location.access_point.to_s.gsub(/_/, ' ').capitalize.pluralize, application_name: "#{I18n.t('blacklight.application_name')} catalog" %>
  <% end %>
<% else %>
  <% constraints_text = render_search_to_page_title(search_state) %>
  <% if constraints_text.present? %>
    <% @page_title = t('blacklight.search.page_title.title', constraints: constraints_text, application_name: application_name) %>
  <% else %>
    <% @page_title = "#{I18n.t('blacklight.application_name')} catalog" %>
  <% end %>
<% end %>
<% view_config = blacklight_config.view_config(document_index_view_type, action_name: action_name) %>
<% content_for(:head) do -%>
  <%= render '/catalog/opensearch_response_metadata' %>
  <%= rss_feed_link_tag %>
  <%= atom_feed_link_tag %>
  <%= json_api_link_tag %>
<% end -%>
<h1 class="visually-hidden">Search Results</h1>
<%= render Searchworks4::SearchResult::CollectionInfoComponent.new(collection: @parent) if page_location.collection? %>
<%= render Searchworks4::SearchResult::BookplateFundComponent.new(bookplate: bookplate_from_document_list) %>
<% if has_search_parameters? && !hide_constraints %>
  <div class="row">
    <div class="constraints col d-flex">
      <%= render view_config.constraints_component.new(search_state:, classes: 'breadcrumb d-inline-flex mb-5') %>
    </div>
  </div>
<% end %>
<% if @response.empty? %>
  <%= render "zero_results" %>
<% else %>
  <% content_for(:skip_links) do -%>
    <%= render Blacklight::SkipLinkItemComponent.new(text: t('blacklight.skip_links.first_result'), href: '#documents') %>
  <% end %>
  <div class="row align-items-start mt-7" data-controller="responsive-aside" data-action="resize@window->responsive-aside#moveContentIfNeeded">
    <% unless hide_facets %>
      <div class="sidebar col-12 md:col-4 2xl:col-3 mb-5" data-controller="analytics" data-responsive-aside-target="default" data-action="hide.bs.collapse->analytics#trackFacetHide show.bs.collapse->analytics#trackFacetShow">
        <button class="btn btn-solid theme-primary d-inline-block md:d-none me-3" type="button" data-bs-toggle="drawer" data-bs-target="#facets-drawer" aria-controls="facets-drawer">
          <i class="bi bi-sliders" aria-hidden="true"></i> Filters
        </button>
        <% if database_aside %>
          <button class="btn btn-solid theme-primary 2xl:d-none" type="button" data-bs-toggle="drawer" data-bs-target="#popular-databases-drawer" aria-controls="popular-databases-drawer">Popular databases</button>
        <% end %>
        <dialog id="facets-drawer" class="md:drawer drawer-bottom drawer-sm-start" aria-label="Filters">
          <div class="drawer-header pb-0">
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
          </div>
          <div class="drawer-body pt-0 flex-column">
            <%= render 'facet_header' %>
            <%= render Facets::GroupComponent.new(id: 'top-filters', title: 'Top filters',
                                                  container_classes: 'facets top-filters sidenav md:mb-7',
                                                  header_classes: 'facets-heading',
                                                  body_classes: 'accordion') do |component| %>
              <% component.with_body do %>
                <%= render Blacklight::FacetComponent.with_collection(blacklight_config.facet_fields_in_group('top'), response: @response) %>
              <% end %>
            <% end %>
            <%= render Facets::GroupComponent.new(id: 'other-filters', title: 'Other filters',
                                                  show_button: !database_aside,
                                                  container_classes: 'facets other-filters sidenav md:mb-7',
                                                  header_classes: 'facets-heading',
                                                  body_classes: 'accordion') do |component| %>
              <% component.with_body do %>
                <div <% unless database_aside %>data-facet-list-target="hideFacets"<% end %> id="hidden-facets">
                  <%= render Blacklight::FacetComponent.with_collection(blacklight_config.facet_fields_in_group(nil).sort_by(&:label), response: @response) %>
                </div>
              <% end %>
            <% end %>
          </div>
        </dialog>
        <% benchmark 'Alt results' do %>
          <%= render view_config.mini_bento_component.new if view_config.mini_bento_component %>
        <% end %>
      </div>
    <% end %>
    <div id="content" class="results col <%= content_classes %>" data-controller="eager-lazy"
         data-action="turbo:before-fetch-request->eager-lazy#frameWillLoad">
      <div class="page-entries-info mb-3 d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <%= render PageLinksComponent.new(response: @response) %>
        <div class="d-flex flex-wrap gap-3 align-items-center">
          <span class="sort-and-per-page d-flex gap-3">
            <%= render partial: 'sort_widget' %>
            <%= render partial: 'shared/per_page_widget' %>
          </span>
          <span><%= render Document::SaveAllBookmarksComponent.new(documents_selector: '#documents') %></span>
        </div>
      </div>
      <div data-inline-turnstile-target="challenge"></div>
      <% # container for all documents in index list view -%>
      <div id="documents" class="documents-<%= document_index_view_type %>">
        <%= render view_config.document_component.with_collection(@response.documents.map { |document| document_presenter(document) }, counter_offset: document_counter_with_offset(-1)) %>
      </div>
      <%= render 'results_pagination' %>
    </div>
    <% if database_aside %>
      <aside class="2xl:col-3 popular-databases-aside">
        <dialog class="2xl:drawer drawer-bottom flex-column popular-databases" id="popular-databases-drawer" aria-labelledby="popular-databases-label">
          <div data-responsive-aside-target="responsive">
          </div>
          <%= content_for(:additional_aside_content) %>
        </dialog>
      </aside>
    <% else %>
      <aside class="2xl:col-3 d-none 2xl:d-block">
        <div data-responsive-aside-target="responsive">
        </div>
        <%= content_for(:additional_aside_content) %>
      </aside>
    <% end %>
  </div>
<% end %>
