<h1 class="h2 mt-3 mb-7"><%= t('blacklight.search.zero_results.page_heading') %></h1>
<div class='row zero-results'>
  <div class="md:col-6 lg:col-4 modify-search">
    <div class="border-before pt-5" data-controller="analytics" data-analytics-category-value="zero-results">
      <h2 class="ps-5 mb-7"><%= t 'blacklight.search.zero_results.modify_your_search' %></h2>
      <ul>
        <% filters = SearchResult::NoResult::FiltersComponent.new(render_headers: false, start_over_component: nil, search_state:) %>
        <% if filters.render? %>
          <li>Remove filters <%= link_to 'Clear all', search_action_path(q: params[:q]), class: "clear-all fg-primary ms-3",
                                 data: { action: "click->analytics#trackLink" } %>
            <%= render filters %>
          </li>
        <% end %>
        <li class="pb-3">Check spelling.</li>
        <li class="pb-3">Use fewer keywords or try different keywords that are broader in meaning.</li>
        <% if from_advanced_search? %>
        <li class="pb-3"><%= link_to t('blacklight.search.zero_results.return_to_advanced_search'), :back, class: 'font-weight-bolder fw-semibold',
                data: { action: "click->analytics#trackLink" } %></li>
        <% else %>
        <li class="pb-3">Try <%= link_to 'advanced search', advanced_search_path,
                    data: { action: "click->analytics#trackLink"} %> to construct a targeted query.</li>
        <% end %>
        <li class="pb-3">Visit our <%= link_to 'SearchWorks Guide', 'https://guides.library.stanford.edu/searchworks' %> for more search tips.</li>
      </ul>
    </div>
  </div>
  <div class="md:col-6 lg:col-4 more-help">
    <div class="border-before ps-5 pt-5">
      <h2 class="mb-7">Need more help?</h2>

      <h3>Contact our reference team</h3>
      <div class="mb-3">
        <%= link_to 'tel:650-725-1064', class: 'icon-link' do %>
          <span class="bi bi-phone"></span>
          (650) 725-1064
        <% end %>
      </div>
      <div class="mb-3">
        <%= link_to 'mailto:library-reference@stanford.edu', class: 'icon-link' do %>
          <span class="bi bi-envelope"></span>
          library-reference@stanford.edu
        <% end %>
      </div>

      <h3 class="mt-7">Stanford affiliates <%= render StanfordOnlyPopoverComponent.new %></h3>

      <%= render Searchworks4::ChatWithLibrarianComponent.new header_class: 'h4', layout: 'block' %>

      <div class="mt-3">
        Place a request via <%= link_to 'Interlibrary loan', 'https://sulils.stanford.edu/' %>.
      </div>

      <div class="mt-1">
        Submit a <%= link_to 'purchase recommendation', 'https://stanforduniversity.qualtrics.com/jfe/form/SV_5iQABR6VSszIQMR' %>.
      </div>

      <h3 class="mt-5">Search other libraries</h3>
      <ul>
        <li class="pb-3">
          <%= link_to 'WorldCat', "https://www.worldcat.org/search?qt=worldcat_org_all&q=#{params.fetch(:q, nil)}" %>
          to search libraries across the globe
        </li>
        <li>
          <%= link_to 'HathiTrust', "https://catalog.hathitrust.org/Search/Home?lookfor=#{params.fetch(:q, nil)}" %>
          to search millions of digitized materials, especially helpful for government documents
        </li>
      </ul>
    </div>
  </div>

  <div class="md:col-12 lg:col-4 zero-result-container">
    <%= render blacklight_config.index.mini_bento_component.new(drawer: false) if blacklight_config.index.mini_bento_component%>
  </div>
</div>
