    <header id="topnav" role="banner">
      <div class="identity-bar">
        <div class="lg:container">
          <a
            class="su-brand-bar__logo d-inline"
            href="https://www.stanford.edu"
            >Stanford University</a
          >
        </div>
      </div>
      <nav class="navbar md:navbar-expand">
        <div class="lg:container">
          <a
            class="mb-0 navbar-brand navbar-logo"
            href="https://library.stanford.edu" aria-label="Stanford University Libraries"></a>
          <button
            class="btn-icon navbar-toggler navbar-toggler-right"
            type="button"
            data-toggle="collapse"
            data-bs-toggle="collapse"
            data-target="#user-util-collapse"
            data-bs-target="#user-util-collapse"
            aria-controls="user-util-collapse"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="md:d-block d-none">
            <%= render 'shared/searchworks4/user_util_links', extra_classes: '' %>
          </div>
        </div>
      </nav>
      <div class="masthead">
        <div class="lg:container">
          <div
            class="d-flex flex-wrap align-items-center pt-5 pb-1 md:pb-5 gap-3"
          >
          <div class="d-flex align-items-center gap-3 flex-grow-1">
              <span class="rosette-logo me-1 align-self-start flex-shrink-0" aria-hidden></span>
              <div class="me-1 flex-grow-1">
                <div class="h1 my-0">
                  <% if controller.is_a? ArticlesController %>
                    <a href="/articles">SearchWorks <span class="fw-semibold">Articles+</span></a>
                  <% else %>
                    <a href="/">SearchWorks <span class="fw-semibold">Catalog</span></a>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="navbars md:ms-auto">
              <nav
                class="collapse navbar-collapse align-items-start md:justify-content-end flex-column md:flex-row"
                aria-label="browse"
                id="user-util-collapse"
              >
                <hr class="md:d-none vw-100 my-0">
                <ul
                  class="navbar-nav md:justify-content-end gap-0 md:gap-7 w-100"
                >
                  <%= render 'shared/searchworks4/catalog_featured_resources' %>

                  <li class="nav-item">
                    <a
                      class="nav-link dropdown-toggle"
                      href="#"
                      role="button"
                      data-bs-toggle="menu"
                      aria-expanded="false"
                    >
                      Help
                    </a>
                    <%= render 'shared/search_navbar_services_menu' %>
                  </li>
                </ul>
                <hr class="md:d-none vw-100 my-0">
                <%= render 'shared/searchworks4/user_util_links', extra_classes: 'md:d-none w-100' %>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </header>
