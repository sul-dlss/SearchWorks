<turbo-frame id="<%= "collection_members_#{document.id}" %>" src="<%= collection_member_path(document.id) %>" target="_top">
  <div class="collection-result-preview">
    <div class="d-inline-flex bg-white ms-7 px-3">
      <h2 class="mb-0">Digital collection</h2>
    </div>
    <div class="md:col-12 image-filmstrip border rounded p-7 pt-12">
      <%= link_to('View all items', collection_members_path(document)) %>
    </div>
  </div>
</turbo-frame>
