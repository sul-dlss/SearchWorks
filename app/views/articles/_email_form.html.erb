<% if @documents.one? %>
  <%= render Searchworks4::RecordSummaryComponent.new(presenter: document_presenter(@documents.first)) %>
<% end %>
<div class="dialog-body">
  <%= turbo_frame_tag 'email_form_frame' do %>
    <%= form_tag url_for(controller: controller_name, action: "email"),
                id: 'email_form',
                class: "modal_form",
                method: :post,
                data: {
                  controller: "email-sent recaptcha",
                  action: "turbo:submit-end->email-sent#done submit->recaptcha#refresh",
                }  do %>
        <% if @documents.one? %>
          <div class="fw-bold">Send</div>
          <div class="form-field d-inline-grid align-items-center me-5 mb-5">
            <%= radio_button_tag :type, 'full', true, class: 'radio' %> <%= label_tag(:type_full, "Full record") %>
          </div>

          <div class="form-field d-inline-grid align-items-center">
            <%= radio_button_tag :type, 'brief', true, class: 'radio' %> <%= label_tag(:type_brief,  "Brief (title, call number, and library location)") %>
          </div>
          <%= render 'shared/email_form', documents: @documents %>
        <% else %>
         <%= hidden_field_tag(:type, 'brief') %>
         <%= render 'shared/email_form', documents: @documents %>
        <% end %>
    <% end %>
  <% end %>
</div>
<div class="dialog-footer">
  <button type="button" data-bl-dismiss="modal" class="btn btn-outline theme-primary">Cancel</button>
  <button type="submit" class="btn btn-solid theme-primary" form="email_form">Send</button>
</div>
