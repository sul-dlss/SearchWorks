<%= tag.section(aria: { label: label }, class: (%w(search-masthead search-area-bg) + classes)) do %>
  <div class="lg:container">
    <div class="row flex-column md:flex-row">
      <section class="col md:pe-12 mb-12 md:mb-0">
        <h1 class="mb-5"><%= header %></h1>
        <%= content %>

        <% if search? %>
          <%= search %>
        <% else %>
          <%= render MastheadSearchComponent.new url: helpers.search_action_url,
                                            advanced_search_url: helpers.search_action_url(action: 'advanced_search'),
                                            params: helpers.search_state.params_for_search.except(:qt),
                                            autocomplete_path: suggest_index_catalog_path %>
        <% end %>
      </section>
      <% if aside? %>
        <section class="col border-md-start md:ps-12">
          <%= aside %>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
