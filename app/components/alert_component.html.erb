<div role="alert" class="alert <%= alert_class %> alert-dismissible shadow-sm d-flex align-items-center">
  <i class="bi <%= icon %> fs-2xl me-5"></i>
  <div class="fg-body">
    <div><%= message %></div>
  </div>
  <button type="button" class="btn-close p-3 mt-1" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
