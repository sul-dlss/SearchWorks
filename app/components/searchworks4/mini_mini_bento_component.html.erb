<div class="d-flex mt-3 mb-5 justify-content-center mini-mini-bento d-none" data-controller="mini-mini-bento analytics" data-analytics-category-value="mini-mini-bento">
  <div class="border py-3 px-5 position-relative d-inline-flex align-items-center gap-3">
    <%= link_to url, class: 'stretched-link fg-secondary link-decoration-none', data: { action: 'click->analytics#trackLink' } do %>
      <span class="fw-normal">SearchWorks</span>
      <span class="fw-bold"><%= name %></span>
    <% end %>

    <span class="badge rounded-pill bento-count" data-mini-mini-bento-target="count"></span>
  </div>
</div>
