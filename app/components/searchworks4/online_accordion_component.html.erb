<details class="accordion-item mb-3"<% if toggled_library? %> open<% end %>>
  <summary class="accordion-header text-digital-green-dark fw-semibold py-3" id="online-header">
    <% if document.is_a_database? %>
      Search this database
    <% elsif document.druid %>
      Also online at
    <% else %>
      Online
    <% end %>
    <%= render Searchworks4::AccordionIconComponent.new %>
  </summary>
  <div id="online" class="accordion-body">
    <%= render AccessPanels::OnlineLinkListComponent.new(document:, links:) %>
  </div>
</details>
