<details class="accordion-item mb-3"<% if toggled_library? %> open<% end %>>
  <summary class="accordion-header justify-content-between">
    <%= render AccessPanels::LibraryHeaderComponent.new(document:, library:) %>
    <div class="text-end"><%= render BadgeCounterComponent.new(item_count, 'item', additional_classes: ['me-5'], color: nil) %></div>
    <%= render Searchworks4::AccordionIconComponent.new %>
  </summary>
  <div id="<%= library.code %>" class="accordion-body">
    <% libraries.each do |lib| %>
      <%= render AccessPanels::AdditionalInfoComponent.new(document:, library: lib) %>
      <%= render Searchworks4::AvailabilityModalLocationComponent.with_collection(lib.locations, document: @document, library: lib) %>
    <% end %>
  </div>
</details>
