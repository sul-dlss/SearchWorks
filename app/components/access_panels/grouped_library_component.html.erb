<div class="d-flex flex-column mt-3 mb-7 panel-library-location">
  <div class="library-location-heading bg-2 ms-n3 ps-5 py-3 mb-5 position-relative">
    <h3 class="h4 p-0 m-0 fw-semibold"><%= label %></h3>
  </div>

  <% libraries.each do |library| %>
    <%= render AccessPanels::LibraryLocationComponent.with_collection(library.locations, document:, library:) %>
  <% end %>
</div>
