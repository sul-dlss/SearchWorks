<%= render @layout.new(classes: 'panel-appears-in') do |component| %>
  <% component.with_title(tag: 'h3', classes: ['h4', 'ms-n3', 'ps-5', 'bg-2', 'py-3']) do %>
    Item is included in another record
  <% end %>
  <% component.with_body do %>
    <% @document.parent_sets.each do |parent_set| %>
      <h4>
        <%= helpers.render_resource_icon parent_set.document_formats %>
        <%= helpers.link_to_document(parent_set) %>
      </h4>
    <% end %>
  <% end %>
<% end %>
