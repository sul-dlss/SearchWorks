<% if drawer? %>
<div class="md:d-none mb-3 d-inline-block w-auto text-nowrap mini-bento-btn-wrapper">
  <button class="mini-bento btn btn-outline theme-primary col-12" data-bs-toggle="drawer" data-bs-target="#alternate-catalog-drawer" aria-controls="alternate-catalog-drawer">
    <span>Looking for more?</span>
  </button>
</div>
<% end %>

<%= content_tag(drawer? ? :dialog : :div, class: ('md:drawer drawer-bottom flex-column' if drawer?), aria: { label: ('Looking for more?' if drawer?) }, data: { responsive_aside_target: 'content' }, id: 'alternate-catalog-drawer') do %>
  <div class='alternate-catalog md:mb-5' data-controller="analytics mini-bento" data-mini-bento-url-value="<%= url %>" data-mini-bento-mini-mini-bento-outlet=".mini-mini-bento" data-analytics-category-value="alternate-catalog">
    <div class="alternate-catalog-heading row">
      <h2 class="alternate-catalog-title col mb-5" data-mini-bento-target="title">Looking for more?</h2>
      <% if drawer? %>
        <button type='button' class='alternate-catalog-close btn-close col-2 me-3 md:d-none d-block' data-bs-dismiss="drawer" aria-label="Close"></button>
      <% end %>
    </div>
    <div class="placeholder-glow d-none" data-mini-bento-target="placeholder">
      <div class="placeholder d-block bg-danger w-50 p-5 mb-3"></div>
      <div class="placeholder d-block p-1 w-100 mb-1"></div>
      <div class="placeholder d-block p-1 w-25 mb-5"></div>
      <div class="placeholder d-block p-5 w-50 mb-5"></div>
      <div class="placeholder d-block p-1 w-75 mb-3"></div>
      <div class="placeholder d-block p-1 w-50 mb-3"></div>
      <div class="placeholder d-block p-1 w-75 mb-3"></div>
      <div class="placeholder d-block p-1 w-25 mb-3"></div>
    </div>
    <div class="alternate-catalog-body row d-none" data-mini-bento-target="body">
      <div class="alternate-catalog-primary-tools col-12 sm:col-6 md:col-12">
        <h3 class="alternate-catalog-name mb-0">
          <span class="fw-normal">SearchWorks</span>
          <%= name %>
          <span class="badge rounded-pill alternate-catalog-count bento-count" data-mini-bento-target="count"></span>
        </h3>
        <div class="alternate-catalog-desc mb-3">
          <%= description %>
        </div>
        <div>
          <%= link_to(url, class: 'btn btn-outline theme-secondary', data: { action: "click->analytics#trackLink"}) do %>
            View <%= result_singular %> results
          <% end %>
        </div>
      </div>

      <div class="alternate-catalog-other-tools col-12 sm:col-6 md:col-12">
        <div class="d-flex flex-wrap align-items-baseline mb-1">
          <h3 class="alternate-catalog-name mb-1 me-3">
            Other search tools
          </h3>
          <div class="alternate-catalog-view-all mb-3">
            <%= link_to(bento_url) do %>
              View results from all tools
            <% end %>
          </div>
        </div>

        <div class="mb-3" data-controller="blacklight-result-count" data-blacklight-result-count-url-value="<%= archive_search_url %>">
          <%= link_to archive_search_url, class: 'me-3' do %>
            Archival Collections at Stanford
          <% end %>
          <span class="badge rounded-pill bento-count" data-blacklight-result-count-target="count"></span>
        </div>

        <div class="mb-3" data-controller="blacklight-result-count" data-blacklight-result-count-url-value="<%= geo_search_url %>">
          <%= link_to geo_search_url,  class: 'me-3' do %>
            EarthWorks for geospatial data and maps
          <% end %>
          <span class="badge rounded-pill bento-count" data-blacklight-result-count-target="count"></span>
        </div>

        <div class="mb-3" data-controller="bento-result-count" data-bento-result-count-url-value="<%= bento_search_url('libguides') %>">
          <%= link_to '', class: 'me-3', data: {'bento-result-count-target': 'link'} do %>
            Guides to collections, tools, and services
          <% end %>
          <span class="badge rounded-pill bento-count" data-bento-result-count-target="count"></span>
        </div>

        <div data-controller="blacklight-result-count" data-blacklight-result-count-url-value="<%= exhibits_search_url %>">
          <%= link_to exhibits_search_url, class: 'me-3' do %>
            Spotlight Exhibits
          <% end %>
          <span class="badge rounded-pill bento-count" data-blacklight-result-count-target="count"></span>
        </div>
      </div>
    </div>
  </div>
<% end %>
