{
  "name": "app",
  "private": "true",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/dom": "^1.7.6",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.13",
    "@hotwired/turbo-rails": "^8.0.0",
    "@mui/material": "^7.2.0",
    "blacklight-frontend": "github:projectblacklight/blacklight#bootstrap6",
    "blacklight-hierarchy": "github:sul-dlss/blacklight-hierarchy#bs6",
    "blacklight-range-limit": "github:projectblacklight/blacklight_range_limit#bs6",
    "bootstrap": "6.0.0-alpha.1",
    "esbuild": "^0.25.0",
    "fetch-jsonp": "^1.3.0",
    "leaflet": "1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.72.0",
    "vanilla-calendar-pro": "^3.4.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.1"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild app/javascript/searchworks4.js app/javascript/searchworks4-adv-search.js --minify --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets",
    "build:dev": "esbuild app/javascript/searchworks4.js app/javascript/searchworks4-adv-search.js --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/searchworks4.scss:./app/assets/builds/searchworks4.css --no-source-map --quiet-deps --load-path=node_modules",
    "lint": "eslint app/javascript/",
    "lint:fix": "eslint app/javascript/ --fix",
    "test": "node --test spec/javascript/*.test.js"
  },
  "resolutions": {
    "bootstrap": "6.0.0-alpha.1"
  }
